{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "type": "stdio"
    },
    "chrome-devtools": {
      "command": "bunx",
      "args": ["chrome-devtools-mcp@1.8.0", "--no-usage-statistics"],
      "type": "stdio",
      "enabled": false
    },
    "ssh-manager": {
      "command": "mcp-ssh-manager",
      "type": "stdio",
      "enabled": false
    },
    "zscan": {
      "command": "npx",
      "args": ["-y", "@eajdias/zscan-run", "assist"],
      "env": {
        "ZSCAN_LAUNCHER_COMMAND": "npx",
        "ZSCAN_PRODUCT_ID": "assist"
      },
      "type": "stdio",
      "enabled": false
    }
  }
}
