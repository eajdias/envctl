{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/envctl-verify --hook",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Shell(git:*)",
      "Shell(go:*)",
      "Shell(npm:*)",
      "Shell(npx:*)",
      "Shell(pnpm:*)",
      "Shell(bun:*)",
      "Shell(bunx:*)",
      "Shell(pytest:*)",
      "Shell(cargo test:*)",
      "Shell(dotnet test:*)",
      "Shell(docker:*)"
    ],
    "ask": [
      "Shell(rm:*)",
      "Shell(sudo:*)",
      "Shell(git push:*)",
      "Shell(git commit:*)",
      "Read(.env*)",
      "Read(~/.commandcode/auth.json)"
    ],
    "deny": [
      "Shell(git push --force*)",
      "Shell(git reset --hard*)",
      "Shell(git clean -*)",
      "Edit(.git/**)"
    ]
  }
}
