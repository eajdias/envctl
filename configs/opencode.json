{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "initialization": {
        "preferences": {
          "importModuleSpecifierPreference": "relative"
        }
      }
    },
    "pyright": {
      "command": ["pyright-langserver", "--stdio"]
    },
    "pylsp": {
      "command": ["pylsp"],
      "extensions": [".py", ".pyi"]
    },
    "gopls": {
      "command": ["gopls"]
    },
    "bash": {
      "command": ["bash-language-server", "start"]
    },
    "sql": {
      "command": ["sqllens-language-server", "--stdio"],
      "extensions": [".sql"]
    },
    "html": {
      "command": ["vscode-html-language-server", "--stdio"],
      "extensions": [".html", ".htm"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "css": {
      "command": ["vscode-css-language-server", "--stdio"],
      "extensions": [".css", ".scss", ".less"]
    },
    "markdown": {
      "command": ["vscode-markdown-language-server", "--stdio"],
      "extensions": [".md", ".markdown"]
    },
    "powershell": {
      "command": [
        "pwsh",
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "Import-Module PowerShellEditorServices; Start-EditorServices -HostName \"opencode\" -HostProfileId \"opencode\" -HostVersion \"1.0.0\" -Stdio -SessionDetailsPath \"$env:TEMP\\pses_session.json\" -LogPath \"$env:TEMP\\pses.log\" -LogLevel Normal"
      ],
      "extensions": [".ps1", ".psm1", ".psd1"]
    },
    "dockerfile": {
      "command": ["docker-langserver", "--stdio"],
      "extensions": ["Dockerfile", ".dockerfile"]
    },
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "csharp": {
      "command": ["csharp-ls"],
      "extensions": [".cs"]
    },
    "eslint": {
      "command": ["vscode-eslint-language-server", "--stdio"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"]
    },
    "toml": {
      "command": ["taplo", "lsp"],
      "extensions": [".toml"]
    },
    "php": {
      "command": ["intelephense", "--stdio"],
      "extensions": [".php"]
    }
  },
  "skills": {
    "paths": [
      "~/.config/opencode/skills"
    ]
  },
  "references": {
    "playwright": {
      "path": "~/.config/opencode/skills/playwright-cli",
      "description": "Browser automation with Playwright Node.js API"
    },
    "envctl": {
      "path": "C:/projetos/git-privado/envctl",
      "description": "envctl - VPS/VM provisioner (Go CLI) source repo; bootstrap: curl -fsSL https://raw.githubusercontent.com/eajdias/envctl/main/bootstrap.sh | bash; commands: envctl run all / run shell / doctor / snapshot"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.config/opencode/secrets/context7.key}"
      },
      "enabled": true
    },
    "ssh-manager": {
      "type": "local",
      "command": ["mcp-ssh-manager"],
      "enabled": false
    },
    "zscan": {
      "type": "local",
      "command": ["npx", "-y", "@eajdias/zscan-run", "assist"],
      "environment": {
        "ZSCAN_LAUNCHER_COMMAND": "npx",
        "ZSCAN_PRODUCT_ID": "assist"
      },
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chromium"],
      "timeout": 30000,
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"],
      "timeout": 30000,
      "enabled": false
    }
  },
  "permission": {
    "skill": {
      "firecrawl-*": "deny"
    }
  },
  "instructions": [
    "https://raw.githubusercontent.com/JRedeker/opencode-shell-strategy/trunk/shell_strategy.md"
  ],
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "@dietrichgebert/ponytail",
    "@prevalentware/opencode-goal-plugin"
  ]
}