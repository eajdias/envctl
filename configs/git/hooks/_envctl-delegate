#!/usr/bin/env sh
# Shared delegator for the hooks envctl installs through core.hooksPath.
#
# Setting core.hooksPath makes git ignore every repository's .git/hooks, so a
# hook a repository installed itself (plain .git/hooks, pre-commit framework,
# lefthook, ...) would silently stop running. This hands control back to it.
# husky-style repositories are unaffected: they set core.hooksPath locally, and
# repository config wins over the global one.
#
# Usage: _envctl-delegate <hook-name> [args...]

set -u

hook_name="$1"
shift

# The repository's own hooks live in the COMMON git dir, which is where
# --git-common-dir points. --git-dir returns the per-worktree dir in a linked
# worktree (.git/worktrees/<name>), which has no hooks/ — the repo's hook would be
# silently skipped there. --git-common-dir resolves correctly in both cases.
git_common=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
repo_hook="${git_common}/hooks/${hook_name}"

if [ -x "$repo_hook" ]; then
	exec "$repo_hook" "$@"
fi

exit 0
