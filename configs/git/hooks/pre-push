#!/usr/bin/env sh
# Global git pre-push hook, provisioned by envctl (core.hooksPath).
#
# The repository's own pre-push (husky and friends) runs first via the shared
# _envctl-delegate next to this file — the same chain every other hook uses —
# then the envctl verifier runs the repository's own quality gates. Any
# non-zero exit aborts the push.

set -u

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
"${here}/_envctl-delegate" "pre-push" "$@" || exit $?

verifier=""
if [ -n "${HOME:-}" ]; then
	verifier="${HOME}/.local/bin/envctl-verify"
	if [ -x "$verifier" ]; then
		exec "$verifier" --git-push
	fi
fi

verifier=$(command -v envctl-verify 2>/dev/null || true)
if [ -n "$verifier" ] && [ -x "$verifier" ]; then
	exec "$verifier" --git-push
fi

# No verifier found. By default this warns and lets the push through — the gate is
# a local dev convenience (a push can always use --no-verify), and blocking every
# push in a repo that never provisioned envctl is the worse failure. Set
# ENVCTL_REQUIRE_GATE=1 to restore the hard gate.
if [ -z "${HOME:-}" ]; then
	printf '%s\n' 'envctl-verify: HOME is not set and no verifier was found on PATH' >&2
else
	printf '%s\n' 'envctl-verify: verifier not found; pushing without the gate' >&2
fi
if [ "${ENVCTL_REQUIRE_GATE:-0}" = "1" ]; then
	printf '%s\n' 'envctl-verify: ENVCTL_REQUIRE_GATE=1 set; refusing an ungated push' >&2
	exit 2
fi
exit 0
