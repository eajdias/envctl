#!/usr/bin/env sh
# Provisioned by envctl (core.hooksPath): run the repository's own pre-commit.
# The delegate is resolved next to this file, so the hook keeps working wherever
# the hooks directory lives and cannot point at a missing path.
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
exec "${here}/_envctl-delegate" "pre-commit" "$@"
