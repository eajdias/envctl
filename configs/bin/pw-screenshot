#!/usr/bin/env node
const { chromium } = require('playwright');
const fs = require('fs');
const os = require('os');
const path = require('path');

async function launchBrowser() {
  const customPath = process.env.CHROME_PATH || process.env.BRAVE_NIGHTLY_PATH || undefined;
  if (customPath && fs.existsSync(customPath)) {
    try {
      return await chromium.launch({ headless: true, executablePath: customPath });
    } catch (e) {
      console.warn(`Warning: Failed to launch custom browser at ${customPath}: ${e.message}`);
    }
  }
  try {
    return await chromium.launch({ headless: true, channel: 'chrome' });
  } catch {
    try {
      return await chromium.launch({ headless: true });
    } catch (e) {
      console.error('Error: No compatible browser found. Install Google Chrome or run "npx playwright install chromium".');
      process.exit(1);
    }
  }
}

(async () => {
  const url = process.argv[2];
  if (!url) {
    console.error('Usage: pw-screenshot <url> [output.png] [width] [height]');
    process.exit(1);
  }
  const tempDir = process.env.ENVCTL_TEMP || path.join(os.tmpdir(), 'envctl');
  fs.mkdirSync(tempDir, { recursive: true });
  const output = process.argv[3] || path.join(tempDir, 'screenshot.png');
  const width = parseInt(process.argv[4] || '1280', 10);
  const height = parseInt(process.argv[5] || '720', 10);

  const browser = await launchBrowser();
  try {
    const context = await browser.newContext({
      viewport: { width, height }
    });
    const page = await context.newPage();
    try {
      await page.goto(url, { waitUntil: 'networkidle', timeout: 15000 });
    } catch {
      await page.goto(url, { waitUntil: 'domcontentloaded', timeout: 15000 });
    }
    await page.screenshot({ path: path.resolve(output), fullPage: true });
    console.log(`Screenshot saved to: ${path.resolve(output)}`);
  } catch (err) {
    console.error('Error taking screenshot:', err.message);
    process.exit(1);
  } finally {
    await browser.close();
  }
})();
