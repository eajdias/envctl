#!/usr/bin/env node
const { chromium } = require('playwright');
const fs = require('fs');

async function launchBrowser() {
  const customPath = process.env.CHROME_PATH || process.env.BRAVE_NIGHTLY_PATH || undefined;
  if (customPath && fs.existsSync(customPath)) {
    try {
      return await chromium.launch({ headless: true, executablePath: customPath });
    } catch (e) {
      console.warn(`Warning: Failed to launch custom browser at ${customPath}: ${e.message}`);
    }
  }
  try {
    return await chromium.launch({ headless: true, channel: 'chrome' });
  } catch {
    try {
      return await chromium.launch({ headless: true });
    } catch (e) {
      console.error('Error: No compatible browser found. Install Google Chrome or run "npx playwright install chromium".');
      process.exit(1);
    }
  }
}

(async () => {
  const url = process.argv[2];
  const query = process.argv[3];
  if (!url) {
    console.error('Usage: pw-eval <url> [selector_or_expression]');
    process.exit(1);
  }

  const browser = await launchBrowser();
  try {
    const page = await browser.newPage();
    await page.goto(url, { waitUntil: 'domcontentloaded', timeout: 30000 });
    if (!query) {
      const title = await page.title();
      const text = await page.innerText('body');
      console.log(`Title: ${title}\n\nContent:\n${text.slice(0, 2000)}...`);
    } else {
      const result = await page.evaluate((expr) => {
        try {
          const el = document.querySelector(expr);
          if (el) return el.innerText || el.textContent;
          return eval(expr);
        } catch (e) {
          return e.message;
        }
      }, query);
      console.log(typeof result === 'object' ? JSON.stringify(result, null, 2) : result);
    }
  } catch (err) {
    console.error('Error:', err.message);
    process.exit(1);
  } finally {
    await browser.close();
  }
})();
