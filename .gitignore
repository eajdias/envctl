# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/dist/
/bin/
/envctl
/envctl-*
/win11-new
/win11-new-*

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Secrets and local overrides
*.env
*.env.local
*.pem
*.key

# IDEs
.idea/
.vscode/
*.swp
*.swo

# PowerShell Editor Services session file (per-session NamedPipe names)
PowerShellEditorServices.json

# Playwright MCP scratch
.playwright-mcp/

# Playwright CLI session snapshots
.playwright-cli/

# CommandCode project scope. Authored artifacts are shared with the team
# (skills/, commands/, agents/ — see the docs); per-machine state stays local:
# settings.json (session approvals + machine-absolute paths), settings.local.json
# and the learned taste profile.
.commandcode/*
!.commandcode/skills/
!.commandcode/commands/
!.commandcode/agents/

# Local git worktrees created for parallel agent sessions
/.worktrees/

# OS specific
Thumbs.db
Desktop.ini
